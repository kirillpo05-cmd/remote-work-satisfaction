# Every variable here is OPTIONAL. The product starts and works with none of
# them set (CLAUDE.md rule 6); this file only documents what can be overridden.

# Base URL the Streamlit UI uses to reach the API.
# Default outside Docker: http://localhost:8000
# Under docker compose the ui service is given http://api:8000 automatically.
#RWSAT_API_URL=http://localhost:8000
